# Log rotation for the AI filter.
#
# The entries are pseudonymised, not anonymised, so they stay personal data:
# keep the files root-only and do not hold them longer than needed.
#
# If these files ever grow far beyond `rotate` days, logrotate is not running.
# Check with: logrotate -d /etc/logrotate.d/ai-filter
/opt/mailcow-dockerized/data/logs/ai-checker/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0600 root root
    copytruncate
}
