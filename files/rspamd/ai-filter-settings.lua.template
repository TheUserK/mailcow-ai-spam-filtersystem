-- AI Content Filter Settings
-- Auto-generated by install.sh - safe to edit manually
-- After changes: restart rspamd (docker compose restart rspamd-mailcow)

ai_filter_settings = {
  -- URL of the AI checker service
  checker_url = 'http://ai-checker:8080/ai-mail-checker.php',

  -- Skip AI check if Rspamd score is already above/below these values
  skip_score_above = 14.0,
  skip_score_below = -10.0,

  -- HTTP timeout for AI check (seconds)
  http_timeout = 30.0,

  -- Log-only mode: log what the AI would have added but don't apply the score
  log_only_mode = false,

  -- Whitelisted sender domains (skip AI check entirely, saves an API call)
  -- Example: whitelist_domains = {'example.com', 'trusted.de'},
  whitelist_domains = {},

  -- Whitelisted sender addresses (skip AI check entirely, saves an API call)
  -- Example: whitelist_senders = {'noreply@bank.de', 'alerts@monitor.local'},
  whitelist_senders = {},
}
